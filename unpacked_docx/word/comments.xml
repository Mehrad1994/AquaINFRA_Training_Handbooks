<?xml version="1.0" encoding="utf-8" standalone="yes"?><w:comments xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:oel="http://schemas.microsoft.com/office/2019/extlst" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16du="http://schemas.microsoft.com/office/word/2023/wordml/word16du" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:comment w:initials="AA" w:author="Andris Andrusaitis" w:date="2026-06-02T10:49:00Z" w:id="70"><w:p w:rsidR="00494C96" w:rsidP="00494C96" w:rsidRDefault="00494C96" w14:paraId="5851F105" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText200" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference200" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>@ Astra: pls check the link!</w:t></w:r></w:p></w:comment><w:comment w:initials="AL" w:author="Astra Labuce" w:date="2026-06-02T13:13:00Z" w:id="71"><w:p w:rsidR="009D7653" w:rsidRDefault="009D7653" w14:paraId="64677533" w14:textId="567FF74E"><w:r><w:annotationRef /></w:r><w:r w:rsidRPr="64DA813E"><w:t>Henning suggested to add a link to DDAS report. ?</w:t></w:r></w:p></w:comment><w:comment w:initials="IJ(L" w:author="Iveta Jurgensone (LV LIAE)" w:date="2026-05-27T09:50:00Z" w:id="110"><w:p w:rsidR="003471D6" w:rsidP="003471D6" w:rsidRDefault="008076D8" w14:paraId="184AFFE9" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText200" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference200" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidR="003471D6"><w:t>@Therese: Pls insert athe link to the Workflow in Galaxy</w:t></w:r></w:p></w:comment><w:comment w:initials="SK" w:author="Koponen Sampsa" w:date="2026-06-03T13:41:00Z" w:id="134"><w:p w:rsidR="00E91C20" w:rsidP="00E91C20" w:rsidRDefault="00E91C20" w14:paraId="27551835" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText2" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference2" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>Perhaps some text here explaining the content and logic of the chapter?</w:t></w:r></w:p></w:comment><w:comment w:initials="SS" w:author="Solvita Strāķe" w:date="2026-06-17T12:52:00Z" w:id="135"><w:p w:rsidR="0010062D" w:rsidRDefault="0010062D" w14:paraId="7EB10473" w14:textId="2124FF64"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="14D948F3"><w:t>We will do it.</w:t></w:r></w:p></w:comment><w:comment w:initials="TH" w:author="Therese Harvey" w:date="2026-05-11T16:12:00Z" w:id="151"><w:p w:rsidR="008076D8" w:rsidRDefault="008076D8" w14:paraId="651C526A" w14:textId="6088EAF8"><w:r><w:annotationRef /></w:r><w:r w:rsidRPr="0DE0B3DD"><w:t>Not sure with task this belongs to- Sintef is in charge I think</w:t></w:r></w:p></w:comment><w:comment w:initials="AA" w:author="Andris Andrusaitis" w:date="2026-06-02T11:06:00Z" w:id="152"><w:p w:rsidR="007335B7" w:rsidP="007335B7" w:rsidRDefault="007335B7" w14:paraId="7D60FC12" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText200" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference200" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>@TH: Please check this!</w:t></w:r></w:p></w:comment><w:comment w:initials="AA" w:author="Andris Andrusaitis" w:date="2026-06-02T11:18:00Z" w:id="158"><w:p w:rsidR="007139FD" w:rsidP="007139FD" w:rsidRDefault="007139FD" w14:paraId="670C84F5" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText200" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference200" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>@All UCs: Please check this chapter and add your candidates for the “common benefits”!</w:t></w:r></w:p></w:comment><w:comment w:initials="AA" w:author="Andris Andrusaitis" w:date="2026-06-02T11:20:00Z" w:id="160"><w:p w:rsidR="00DC605A" w:rsidP="00DC605A" w:rsidRDefault="00DC605A" w14:paraId="156D609B" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText200" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference200" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>@ALL UCs: Please check this chapter and supplement if necessary.</w:t></w:r></w:p></w:comment><w:comment w:initials="xg" w:author="xgarcia" w:date="2026-06-11T15:23:00Z" w:id="175"><w:p w:rsidR="00B045E3" w:rsidRDefault="00B045E3" w14:paraId="7C429FCE" w14:textId="1F019FD2"><w:pPr><w:pStyle w:val="CommentText2" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference2" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="61690D03"><w:t>Since the description of Task 5.3 says that we have to formulate a roadmap/plan for upscaling, it might be worth to add a brief forward-looking paragraph here that references the roadmap and ties it to the barriers and user groups identified in this chapter: something like "the challenges identified above inform the roadmap presented in Chapter X." That would give this chapter a stronger sense of closure and connection to the rest of the deliverable, without duplicating content.</w:t></w:r></w:p></w:comment><w:comment w:initials="SK" w:author="Koponen Sampsa" w:date="2026-06-12T17:29:00Z" w:id="176"><w:p w:rsidR="00B538B0" w:rsidP="00B538B0" w:rsidRDefault="00B538B0" w14:paraId="3075F1B1" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>I’ve added a starting paragraph and moved things around a bit to get to a better story flow.</w:t></w:r></w:p></w:comment><w:comment w:initials="AA" w:author="Andris Andrusaitis" w:date="2026-05-11T14:49:00Z" w:id="171"><w:p w:rsidR="00B93008" w:rsidP="00B93008" w:rsidRDefault="008076D8" w14:paraId="352188FB" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText200" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference200" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidR="00B93008"><w:t xml:space="preserve">@ everybody: Please look into the preliminary text drafted by SYKE. Be welcome to add your suggestions! </w:t></w:r></w:p><w:p w:rsidR="00B93008" w:rsidP="00B93008" w:rsidRDefault="00B93008" w14:paraId="2FA28E2C" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText200" /></w:pPr><w:r><w:t xml:space="preserve">As communicated before: a dedicated brainstorm on this will be arranged on 2 June! </w:t></w:r></w:p></w:comment><w:comment w:initials="AA" w:author="Andris Andrusaitis" w:date="2026-06-02T11:45:00Z" w:id="172"><w:p w:rsidR="00F05052" w:rsidP="00F05052" w:rsidRDefault="00355660" w14:paraId="6BA030C4" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText200" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference200" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidR="00F05052"><w:t xml:space="preserve">The current text is very good, but it applies mostly to the challenges of using a VRE on the Galaxy platform. It could serve as an excellent intro to the previous section (4). In this section, however, we need to outline the next steps in potential expansion of the approach pioneered by AquaINFRA. </w:t></w:r></w:p></w:comment><w:comment w:initials="SK" w:author="Koponen Sampsa" w:date="2026-06-02T14:13:00Z" w:id="173"><w:p w:rsidR="00E32199" w:rsidP="00E32199" w:rsidRDefault="00E32199" w14:paraId="2B45985C" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText200" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference200" /></w:rPr><w:annotationRef /></w:r><w:r><w:t xml:space="preserve">Sampsa to start adding sub-chapters based on Anna-Kaisa’s article </w:t></w:r></w:p></w:comment><w:comment w:initials="KM" w:author="Kämäri Maria" w:date="2026-06-02T17:04:00Z" w:id="174"><w:p w:rsidR="00851541" w:rsidRDefault="00851541" w14:paraId="26948AE6" w14:textId="2D8FE2AA"><w:pPr><w:pStyle w:val="CommentText200" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference200" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="31D63D54"><w:t>I added a couple of subtitles as preliminary ideas</w:t></w:r></w:p></w:comment><w:comment w:initials="xg" w:author="xgarcia" w:date="2026-06-11T15:34:00Z" w:id="177"><w:p w:rsidR="00B045E3" w:rsidRDefault="00B045E3" w14:paraId="2D676CA6" w14:textId="1A7148C4"><w:pPr><w:pStyle w:val="CommentText2" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference2" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="5A164551"><w:t>This section I find it defensive, I would re-write it to be more positive. There is certainly abuse of AI tools, but AI can also be seen as an opportunity. AI assisted coding can lower the entry barrier to become intermediate or expert user, and could be explicitly built into the onboarding strategy. A bit late for AquaINFRA, but future projects could have AI assisted tutorials or a prompt that could help researchers to code faster.</w:t></w:r></w:p></w:comment><w:comment w:initials="SK" w:author="Koponen Sampsa" w:date="2026-06-12T17:27:00Z" w:id="178"><w:p w:rsidR="00B538B0" w:rsidP="00B538B0" w:rsidRDefault="00B538B0" w14:paraId="344346DD" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>I’ve rewritten this section and added more things AI could help with</w:t></w:r></w:p></w:comment><w:comment w:initials="xg" w:author="xgarcia" w:date="2026-06-11T15:38:00Z" w:id="179"><w:p w:rsidR="00B045E3" w:rsidRDefault="00B045E3" w14:paraId="3B3B2E50" w14:textId="05791875"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="356D8E15"><w:t>This section emphasizes what has been done but will benefit from adding some text about future steps (the title of the chapter). What actions we (as AquaINFRA) recommend to address the remaining data sharing, harmonization, and metadata challenges?</w:t></w:r></w:p></w:comment><w:comment w:initials="SK" w:author="Koponen Sampsa" w:date="2026-06-12T17:30:00Z" w:id="180"><w:p w:rsidR="00B538B0" w:rsidP="00B538B0" w:rsidRDefault="00B538B0" w14:paraId="2F18C57D" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>Some recommendations have been added</w:t></w:r></w:p></w:comment><w:comment w:initials="SK" w:author="Koponen Sampsa" w:date="2026-06-12T12:26:00Z" w:id="181"><w:p w:rsidR="00592637" w:rsidP="00592637" w:rsidRDefault="00592637" w14:paraId="6BE96941" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>Can we determine a number for this?</w:t></w:r></w:p></w:comment><w:comment w:initials="DF" w:author="Dmitry Frank-Kamenetsky" w:date="2026-06-15T09:27:00Z" w:id="182"><w:p w:rsidR="00E8258A" w:rsidRDefault="00E8258A" w14:paraId="65A210A1" w14:textId="739B5D94"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="67EC801E"><w:t xml:space="preserve">I suspect it's not possible. HELCOM systematically worked on the development, documentation and publication of 11 datasets related to input of nutrients and connected to measures. However, DDAS harvests everything which is in HELCOM metadata catalogue, which contains thousands datasets. Unfortunately, it includes outdated and not maintained ones. </w:t></w:r></w:p></w:comment><w:comment w:initials="SK" w:author="Koponen Sampsa" w:date="2026-06-15T13:40:00Z" w:id="183"><w:p w:rsidR="00874658" w:rsidP="00874658" w:rsidRDefault="00874658" w14:paraId="0E02A1EC" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>Am I missing a system/service category?</w:t></w:r></w:p></w:comment><w:comment w:initials="xg" w:author="xgarcia" w:date="2026-06-11T15:35:00Z" w:id="184"><w:p w:rsidR="00B045E3" w:rsidRDefault="00B045E3" w14:paraId="6BAA58E1" w14:textId="24A988E5"><w:pPr><w:pStyle w:val="CommentText2" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference2" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="06C59862"><w:t>The connection to EOSC and AIP/DDAS is missing. Given the project's central goal of integrating with EOSC, this chapter should explicitly discuss how broader uptake connects to EOSC visibility, how the AquaINFRA Interaction Platform factors into onboarding new users, and what the pan-European scaling pathway looks like through that lens. Right now the chapter reads as internally focused.</w:t></w:r></w:p></w:comment><w:comment w:initials="SK" w:author="Koponen Sampsa" w:date="2026-06-12T17:34:00Z" w:id="185"><w:p w:rsidR="00592A1A" w:rsidP="00592A1A" w:rsidRDefault="00592A1A" w14:paraId="66248928" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>Good points, but at least at the moment I do not have answers. We’ll have to discuss</w:t></w:r></w:p></w:comment><w:comment w:initials="xg" w:author="xgarcia" w:date="2026-06-11T15:42:00Z" w:id="186"><w:p w:rsidR="00B045E3" w:rsidRDefault="00B045E3" w14:paraId="60501898" w14:textId="69E0D35B"><w:pPr><w:pStyle w:val="CommentText2" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference2" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="0D48308C"><w:t>On a final note. There is no mention of sustainability of governance. Who is going to maintain the platform and services after project ends? I think we should add what we have planned, or explicitly say that there isn't one. The reviewers will look for this.</w:t></w:r></w:p></w:comment><w:comment w:initials="SK" w:author="Koponen Sampsa" w:date="2026-06-12T17:32:00Z" w:id="187"><w:p w:rsidR="00B538B0" w:rsidP="00B538B0" w:rsidRDefault="00B538B0" w14:paraId="0A8BE539" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>This is a good point. The platforms are officially under another WP, but I do not know if there is a sustainability roadmap in there. I’ll investigate</w:t></w:r></w:p></w:comment><w:comment w:initials="SK" w:author="Koponen Sampsa" w:date="2026-06-15T17:09:00Z" w:id="188"><w:p w:rsidR="002B0034" w:rsidP="002B0034" w:rsidRDefault="003450BF" w14:paraId="09CF65B2" w14:textId="77777777"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidR="002B0034"><w:t>I added some things under Ch. 5.4 Sustainability of services.</w:t></w:r><w:r w:rsidR="002B0034"><w:br /></w:r><w:r w:rsidR="002B0034"><w:br /></w:r><w:r w:rsidR="002B0034"><w:t>Please have a look.</w:t></w:r></w:p></w:comment><w:comment w:initials="IJ(L" w:author="Iveta Jurgensone (LV LIAE)" w:date="2026-05-26T19:15:00Z" w:id="190"><w:p w:rsidR="008076D8" w:rsidRDefault="008076D8" w14:paraId="2E7B46BD" w14:textId="1C026A5D"><w:pPr><w:pStyle w:val="CommentText200" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference200" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>Šī atsauce ir jocīga, manuprāt tekstā nav</w:t></w:r></w:p></w:comment><w:comment w:initials="IJ(L" w:author="Iveta Jurgensone (LV LIAE)" w:date="2026-05-27T09:27:00Z" w:id="191"><w:p w:rsidR="008076D8" w:rsidRDefault="008076D8" w14:paraId="154340B4" w14:textId="42B4CE9D"><w:pPr><w:pStyle w:val="CommentText200" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference200" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>Ja šie Ir 2 dažādi raksti, tad vajag atsaucē pielikt a un  b, jo vienāds pirmais autors un gads.</w:t></w:r></w:p></w:comment><w:comment w:initials="IJ(L" w:author="Iveta Jurgensone (LV LIAE)" w:date="2026-05-27T09:28:00Z" w:id="192"><w:p w:rsidR="008076D8" w:rsidRDefault="008076D8" w14:paraId="2D674543" w14:textId="49C61A5E"><w:pPr><w:pStyle w:val="CommentText200" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference200" /></w:rPr><w:annotationRef /></w:r><w:r><w:t>Šis laikam nekur tekstā nav</w:t></w:r></w:p></w:comment><w:comment w:initials="HW" w:author="Heinrich Widmann" w:date="2026-07-07T10:27:14" w:id="6690670" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:p w:rsidR="701629DF" w:rsidRDefault="63E77CDA" w14:paraId="7307D46D" w14:textId="01A362FC" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="290316DE" w:rsidR="7DE163DB"><w:t xml:space="preserve">@xgarcia : At the end of section you find the integration of DDAS within the EOSC Finnish node and the publishing of data via B2SHARE mentioned </w:t></w:r></w:p></w:comment><w:comment w:initials="HW" w:author="Heinrich Widmann" w:date="2026-07-07T10:40:45" w:id="1754130549" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:p w:rsidR="6B9B2642" w:rsidRDefault="2444EE2E" w14:paraId="3D4F1F2B" w14:textId="797F5C1D" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="104DBEDC" w:rsidR="5E5F8234"><w:t>I mean : ... at the end of section 5.4. ...</w:t></w:r></w:p></w:comment><w:comment w:initials="HW" w:author="Heinrich Widmann" w:date="2026-07-07T10:50:56" w:id="1051710080" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:p w:rsidR="3ACC249F" w:rsidRDefault="793DBDE2" w14:paraId="287D0F7E" w14:textId="50029C2C" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="291C1544" w:rsidR="4146E8E8"><w:t>See my comment there : While we’ve had various discussions with EOSC nodes, about how the “platform and OGC services” could remain available and operational, there is no commitment or sustainable solution for this—unlike DDAS, which will be integrated into the EOSC FI node</w:t></w:r></w:p></w:comment><w:comment w:initials="LP" w:author="Lluís Pesquer" w:date="2026-06-26T15:58:46" w:id="426322757" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:p w:rsidR="4AB81F36" w:rsidRDefault="3DF1DE9B" w14:paraId="51C08E73" w14:textId="2F56273D" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="1FCE54F0" w:rsidR="4C517902"><w:t>Different font type from the main one used in the document</w:t></w:r></w:p></w:comment><w:comment w:initials="LP" w:author="Lluís Pesquer" w:date="2026-06-26T16:09:46" w:id="790090551" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:p w:rsidR="445D619A" w:rsidRDefault="2190550C" w14:paraId="45D6284C" w14:textId="00D7C234" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="04267C17" w:rsidR="4C4231D4"><w:t>advantage of the results or advantage of the implemented tools?</w:t></w:r></w:p></w:comment><w:comment w:initials="LP" w:author="Lluís Pesquer" w:date="2026-06-26T16:16:36" w:id="2096091839" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:p w:rsidR="1CF16DAF" w:rsidRDefault="73133DCE" w14:paraId="44ED77F7" w14:textId="19ED8B20" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="3ADE5DEE" w:rsidR="0510A9DF"><w:t xml:space="preserve">I suggest to add the URL link to the special issue. I don't find it in the </w:t></w:r><w:r><w:fldChar w:fldCharType="begin" /></w:r><w:r><w:instrText>HYPERLINK https://www.sciencedirect.com/journal/environmental-modelling-and-software/special-issues.</w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate" /></w:r><w:r w:rsidRPr="137FAD91" w:rsidR="11768936"><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t>https://www.sciencedirect.com/journal/environmental-modelling-and-software/special-issues.</w:t></w:r><w:r><w:fldChar w:fldCharType="end" /></w:r><w:r w:rsidRPr="6D0FA6E6" w:rsidR="0CE1AF62"><w:t xml:space="preserve"> @Sampsa, can you add it?</w:t></w:r></w:p></w:comment><w:comment w:initials="LP" w:author="Lluís Pesquer" w:date="2026-06-26T16:31:13" w:id="1362192576" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:p w:rsidR="7A9E4C8B" w:rsidRDefault="61D6FC14" w14:paraId="3616DED4" w14:textId="41C2EBD6" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="6E505515" w:rsidR="256B9FDD"><w:t>Could you add a reference of this CSC data lake? Maybe some non-AquaINFRA member can have a confusion with Copernicus Space Component</w:t></w:r></w:p></w:comment><w:comment w:initials="DF" w:author="Dmitry Frank-Kamenetsky" w:date="2026-06-29T12:13:50" w:id="1576836887" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:p w:rsidR="04D117A5" w:rsidRDefault="28121493" w14:paraId="0EB58A06" w14:textId="37878135" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="0DD7848A" w:rsidR="011B0BC4"><w:t>Most of the recommendations are technical. But, perhaps, policy issues also deserve to be addressed here, don't they?</w:t></w:r></w:p></w:comment><w:comment w:initials="HW" w:author="Heinrich Widmann" w:date="2026-07-07T10:19:40" w:id="31968070" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:p w:rsidR="01133FF0" w:rsidRDefault="3BB38E3E" w14:paraId="75D2C9B4" w14:textId="24A904F6" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="4F8D361E" w:rsidR="59DCEAC3"><w:t>This is copied from our abstract submitted to the EOSC Symposium. @Juha : Please check if you agree to add this here.</w:t></w:r></w:p></w:comment><w:comment w:initials="HW" w:author="Heinrich Widmann" w:date="2026-07-07T10:38:35" w:id="1457000571" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:p w:rsidR="667D14C4" w:rsidRDefault="270DD903" w14:paraId="68691485" w14:textId="31664D69" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:pPr><w:pStyle w:val="CommentText" /></w:pPr><w:r><w:rPr><w:rStyle w:val="CommentReference" /></w:rPr><w:annotationRef /></w:r><w:r w:rsidRPr="53DB88C5" w:rsidR="1E8D16A2"><w:t>Are you sure? It's true that Galaxy itself will continue to be available as an (EOSC) service, but afaik, there's no guarantee that “the tools, processes, and workflows developed in AquaINFRA will remain available.”</w:t></w:r></w:p></w:comment></w:comments>